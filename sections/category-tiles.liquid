            {
              "value": "glove",
              "label": "Luva"
            },
            {
              "value": "cup",
              "label": "Copo descartável"
            },
            {
              "value": "soap",
              "label": "Sabonete"
            },
            {
              "value": "bucket",
              "label": "Balde"
            },
            {
              "value": "sponge",
              "label": "Esponja"
            },
            {
              "value": "dispenser",
              "label": "Dispenser"
            },
            {
              "value": "coffee",
              "label": "Café"
            },
            {
              "value": "box",
              "label": "Caixa"
            },
            {
              "value": "building",
              "label": "Prédio"
            },
            {
              "value": "utensils",
              "label": "Talheres"
            },
            {
              "value": "medical",
              "label": "Saúde"
            },
            {
              "value": "briefcase",
              "label": "Maleta"
            },
