{{ 'section-faq.css' | asset_url | stylesheet_tag }}

<div
  class="section scheme-{{ section.settings.color_scheme }} faq"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container container--narrow">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="section-header__description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="faq__list">
      {%- for block in section.blocks -%}
        {%- if block.settings.question == blank -%}
          {%- continue -%}
        {%- endif -%}
        <details
          class="accordion"
          {% if forloop.first and section.settings.open_first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary class="accordion__summary">
            <h3 class="accordion__title faq__question">{{ block.settings.question }}</h3>
            <span class="faq__toggle" aria-hidden="true"></span>
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>

    {%- if section.settings.contact_text != blank or section.settings.contact_label != blank -%}
      <div class="faq__contact">
        {%- if section.settings.contact_text != blank -%}
          <p class="text-muted">{{ section.settings.contact_text }}</p>
        {%- endif -%}
        {%- if section.settings.contact_label != blank and section.settings.contact_link != blank -%}
          <a class="link-arrow" href="{{ section.settings.contact_link }}">
            {{- section.settings.contact_label -}}
            {% render 'icon', icon: 'arrow-right', size: 16 %}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.structured_data -%}
  {%- liquid
    assign faq_count = 0
    for block in section.blocks
      assign answer_text = block.settings.answer | strip_html | strip
      if block.settings.question != blank and answer_text != blank
        assign faq_count = faq_count | plus: 1
      endif
    endfor
  -%}
  {%- if faq_count > 0 -%}
    {%- assign faq_index = 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            {%- liquid
              assign question_text = block.settings.question | strip_html | strip
              assign answer_text = block.settings.answer | strip_html | strip
              if question_text == blank or answer_text == blank
                continue
              endif
              assign faq_index = faq_index | plus: 1
            -%}
            {
              "@type": "Question",
              "name": {{ question_text | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ answer_text | json }}
              }
            }{% if faq_index < faq_count %},{% endif %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Perguntas frequentes",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Perguntas frequentes"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Abrir a primeira pergunta",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "structured_data",
      "label": "Gerar dados estruturados (FAQPage)",
      "info": "Ajuda buscadores a entenderem as perguntas. Use em apenas uma seção de perguntas por página.",
      "default": true
    },
    {
      "type": "header",
      "content": "Atendimento"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Texto",
      "default": "Não encontrou o que procurava?"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Texto do link",
      "default": "Fale com a gente"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Link"
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pergunta",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Pergunta",
          "default": "Como funcionam o frete e o prazo de entrega?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Resposta",
          "default": "<p>Escreva aqui a resposta, de forma clara e direta.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Perguntas frequentes",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Como funcionam o frete e o prazo de entrega?",
            "answer": "<p>O frete e o prazo são calculados no checkout conforme o seu CEP, antes de você finalizar a compra.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Quais são as formas de pagamento?",
            "answer": "<p>As formas de pagamento disponíveis, incluindo Pix e parcelamento no cartão, aparecem no checkout com as condições válidas para o seu pedido.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Posso comprar para a minha empresa?",
            "answer": "<p>Sim. Atendemos empresas, condomínios e outros estabelecimentos, além de residências. Para pedidos em maior volume, compras recorrentes ou dúvidas sobre nota fiscal, fale com o nosso atendimento.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Como funcionam as trocas e devoluções?",
            "answer": "<p>Se houver algum problema com o seu pedido, fale com o nosso atendimento. As condições e os prazos estão descritos na política de trocas e devoluções da loja.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
