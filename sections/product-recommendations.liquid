{%- liquid
  assign columns = section.settings.columns
-%}

<product-recommendations
  data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&section_id={{ section.id }}&limit={{ section.settings.limit }}&intent=related"
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
      <div class="container" data-slider-scope>
        <div class="section-header">
          <div class="section-header__text">
            <h2 class="h2">{{ section.settings.heading }}</h2>
          </div>
          <div class="slider__buttons slider__buttons--desktop">
            <button type="button" class="slider__button" data-slider-prev aria-label="{{ 'accessibility.previous' | t }}">
              {% render 'icon', icon: 'chevron-left', size: 18 %}
            </button>
            <button type="button" class="slider__button" data-slider-next aria-label="{{ 'accessibility.next' | t }}">
              {% render 'icon', icon: 'chevron-right', size: 18 %}
            </button>
          </div>
        </div>

        <slider-component>
          <ul class="slider slider--bleed" role="list" style="--slides-mobile: 2; --slides-tablet: 3; --slides-desktop: {{ columns }};">
            {%- for product in recommendations.products -%}
              <li class="slider__slide">
                {% render 'product-card', product: product %}
              </li>
            {%- endfor -%}
          </ul>
        </slider-component>
      </div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Produtos relacionados",
  "settings": [
    {
      "type": "paragraph",
      "content": "As recomendações são geradas automaticamente e podem ser ajustadas no app Shopify Search & Discovery."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Você também pode precisar"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Máximo de produtos",
      "min": 4,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Colunas no desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    { "type": "header", "content": "Aparência" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "options": [
        { "value": "default", "label": "Padrão" },
        { "value": "alt", "label": "Fundo alternativo" },
        { "value": "inverse", "label": "Invertido" },
        { "value": "accent", "label": "Destaque" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaçamento superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaçamento inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Produtos relacionados"
    }
  ]
}
{% endschema %}
