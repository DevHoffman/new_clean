{{ 'section-press-logos.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div
    class="section scheme-{{ section.settings.color_scheme }} press-logos"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --logo-max-width: {{ section.settings.logo_width }}px;"
  >
    <div class="container">
      {%- if section.settings.heading != blank -%}
        <h2 class="eyebrow press-logos__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="press-logos__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign logo = block.settings.image
            assign logo_name = block.settings.name | default: logo.alt
            assign retina_width = section.settings.logo_width | times: 2
          -%}
          <li class="press-logos__item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a
                class="press-logos__logo"
                href="{{ block.settings.link }}"
                target="_blank"
                rel="noopener"
                {% if logo != blank and logo_name != blank %}
                  aria-label="{{ logo_name | escape }}"
                {% endif %}
              >
            {%- else -%}
              <div class="press-logos__logo">
            {%- endif -%}
            {%- if logo != blank -%}
              {{
                logo
                | image_url: width: retina_width
                | image_tag: loading: 'lazy', alt: logo_name, sizes: '(min-width: 750px) 200px, 40vw'
              }}
            {%- else -%}
              <span class="press-logos__placeholder">{{ logo_name }}</span>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              </a>
            {%- else -%}
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Como visto em",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Como visto em"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Largura máxima dos logos",
      "min": 80,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "Prefira PNG com fundo transparente."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nome do veículo",
          "info": "Usado como texto alternativo e exibido enquanto não houver imagem.",
          "default": "Seu logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Como visto em",
      "settings": {
        "padding_top": 40,
        "padding_bottom": 40
      },
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
