{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="customer-auth">
      <div class="customer-auth__header">
        <h1 class="h2">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="text-muted">{{ 'customer.reset_password.subtext' | t }}</p>
      </div>

      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="form-message form-message--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="field">
          <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
          <input
            class="field__input"
            type="password"
            name="customer[password]"
            id="ResetPassword"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="field">
          <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
          <input
            class="field__input"
            type="password"
            name="customer[password_confirmation]"
            id="ResetPasswordConfirm"
            autocomplete="new-password"
            required
            {% if form.errors contains 'password_confirmation' %}
              aria-invalid="true"
            {% endif %}
          >
        </div>

        <div class="customer-auth__actions">
          <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Redefinir senha",
  "class": "section-main-reset-password",
  "settings": [
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ]
}
{% endschema %}
