{{ 'section-main-404.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign recover_collection = section.settings.collection
  assign products_limit = section.settings.products_limit
  assign show_products = false
  if section.settings.show_products
    if recover_collection.products_count > 0 or request.design_mode
      assign show_products = true
    endif
  endif
-%}

<div class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="main-404">
      <p class="main-404__code" aria-hidden="true">404</p>
      <h1 class="h1">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'templates.404.title' | t }}
        {%- endif -%}
      </h1>
      <p class="main-404__text text-muted">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          {{ 'templates.404.text' | t }}
        {%- endif -%}
      </p>

      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-form main-404__search">
          <div class="search-form__field">
            {% render 'icon', icon: 'search', size: 18 %}
            <label class="visually-hidden" for="Search-404">{{ 'templates.search.label' | t }}</label>
            <input
              class="field__input search-form__input"
              type="search"
              name="q"
              id="Search-404"
              placeholder="{{ 'templates.search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
            >
            <input type="hidden" name="options[prefix]" value="last">
          </div>
          <button type="submit" class="button">{{ 'templates.search.submit' | t }}</button>
        </form>
      {%- endif -%}

      <div class="main-404__actions">
        <a href="{{ routes.root_url }}" class="button button--secondary">{{ 'general.back_to_home' | t }}</a>
        <a href="{{ routes.all_products_collection_url }}" class="link-arrow">
          {{ 'templates.404.browse_products' | t }}
          {% render 'icon', icon: 'arrow-right', size: 16 %}
        </a>
      </div>
    </div>

    {%- if show_products -%}
      <div class="main-404__products">
        <div class="section-header">
          <div class="section-header__text">
            <h2 class="h2">{{ section.settings.products_heading }}</h2>
          </div>
          {%- if recover_collection != blank -%}
            <a class="link-arrow" href="{{ recover_collection.url }}">
              {{ 'general.view_all' | t }}
              {% render 'icon', icon: 'arrow-right', size: 16 %}
            </a>
          {%- endif -%}
        </div>

        <ul class="grid" role="list" style="--cols-mobile: 2; --cols-tablet: 4; --cols-desktop: 4;">
          {%- if recover_collection.products_count > 0 -%}
            {%- for product in recover_collection.products limit: products_limit -%}
              <li>{% render 'product-card', product: product %}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <li>{% render 'product-card', product: blank %}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Página 404",
  "class": "section-main-404",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Ops! Não encontramos esta página"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "O link pode estar desatualizado ou o produto não está mais disponível. Que tal buscar o que você procura?"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar campo de busca",
      "default": true
    },
    { "type": "header", "content": "Produtos para recuperar a visita" },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Mostrar produtos",
      "default": true
    },
    {
      "type": "text",
      "id": "products_heading",
      "label": "Título",
      "default": "Produtos em destaque"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção",
      "info": "Escolha seus mais vendidos para transformar o erro em uma nova oportunidade de compra."
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Quantidade de produtos",
      "min": 2,
      "max": 8,
      "step": 2,
      "default": 4
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ]
}
{% endschema %}
