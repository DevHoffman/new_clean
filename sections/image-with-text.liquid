{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}

<div
  class="section scheme-{{ section.settings.color_scheme }} image-with-text image-with-text--{{ section.settings.image_position }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="image-with-text__grid">
      <div class="media image-with-text__media image-with-text__media--{{ section.settings.image_ratio }}">
        {%- if section.settings.video != blank -%}
          {{
            section.settings.video
            | video_tag:
              image_size: '1100x',
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              controls: false,
              preload: 'metadata'
          }}
        {%- elsif section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag:
              widths: '400, 600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 1200px) 600px, (min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="image-with-text__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="image-with-text__benefits" role="list">
            {%- for block in section.blocks -%}
              <li class="image-with-text__benefit" {{ block.shopify_attributes }}>
                <span class="image-with-text__benefit-icon">
                  {% render 'icon', icon: block.settings.icon, size: 18 %}
                </span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            class="button{% if section.settings.button_style == 'secondary' %} button--secondary{% endif %} image-with-text__button"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Imagem com texto",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo",
      "info": "Opcional. Substitui a imagem e é reproduzido sem som, em loop."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posição da imagem no desktop",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "right", "label": "Direita" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporção da imagem",
      "options": [
        { "value": "square", "label": "Quadrada (1:1)" },
        { "value": "portrait", "label": "Retrato (4:5)" },
        { "value": "landscape", "label": "Paisagem (4:3)" }
      ],
      "default": "square"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio",
      "default": "Sobre a loja"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Tudo para a limpeza em um só lugar"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Conte aqui o que torna a sua loja a escolha certa: variedade de produtos, atendimento, condições de entrega e de pagamento.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Ver a loja"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Estilo do botão",
      "options": [
        { "value": "primary", "label": "Principal" },
        { "value": "secondary", "label": "Secundário" }
      ],
      "default": "primary"
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "truck", "label": "Caminhão (frete)" },
            { "value": "box", "label": "Caixa (entrega)" },
            { "value": "credit-card", "label": "Cartão de crédito" },
            { "value": "pix", "label": "Pix" },
            { "value": "refresh", "label": "Setas (troca)" },
            { "value": "shield", "label": "Escudo (segurança)" },
            { "value": "lock", "label": "Cadeado" },
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Folha" },
            { "value": "heart", "label": "Coração" },
            { "value": "sparkle", "label": "Brilho" },
            { "value": "droplet", "label": "Gota" },
            { "value": "flask", "label": "Frasco de laboratório" },
            { "value": "sun", "label": "Sol" },
            { "value": "award", "label": "Medalha" },
            { "value": "star", "label": "Estrela" },
            { "value": "gift", "label": "Presente" },
            { "value": "clock", "label": "Relógio" },
            { "value": "chat", "label": "Balão de conversa" },
            { "value": "mail", "label": "E-mail" },
            { "value": "eye", "label": "Olho" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Produtos para empresas e residências"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Imagem com texto",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "check", "text": "Produtos para empresas e residências" } },
        { "type": "benefit", "settings": { "icon": "check", "text": "Linhas profissionais e domésticas" } },
        { "type": "benefit", "settings": { "icon": "check", "text": "Atendimento para tirar suas dúvidas" } }
      ]
    }
  ]
}
{% endschema %}
