{%- liquid
  assign featured = section.settings.collection
  if featured == blank
    assign featured = collections.all
  endif
  assign limit = section.settings.products_to_show
  assign columns = section.settings.columns_desktop
  assign desktop_vw = 100 | divided_by: columns
  assign sizes = '(min-width: 1000px) ' | append: desktop_vw | append: 'vw, (min-width: 750px) 33vw, 50vw'
  assign is_slider = false
  if section.settings.layout == 'slider'
    assign is_slider = true
  endif
  assign show_view_all = false
  if section.settings.show_view_all and featured != blank
    assign show_view_all = true
  endif

  comment
    A section titled "Mais vendidos" must never quietly show the alphabetical
    catalogue: when the chosen collection does not exist yet (or is empty),
    it can be hidden on the storefront.
  endcomment
  assign hide_section = false
  if section.settings.hide_when_empty and section.settings.collection == blank
    assign hide_section = true
  endif
  if section.settings.hide_when_empty and section.settings.collection != blank and section.settings.collection.products_count == 0
    assign hide_section = true
  endif
-%}

{%- if hide_section -%}
  {%- if request.design_mode -%}
    <div class="section">
      <div class="container">
        <p class="form-message form-message--error">{{ 'sections.featured_collection.hidden_notice' | t: heading: section.settings.heading }}</p>
      </div>
    </div>
  {%- endif -%}
{%- else -%}

<div
  class="section scheme-{{ section.settings.color_scheme }} featured-collection"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  {% if is_slider %}
    data-slider-scope
  {% endif %}
>
  <div class="container">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="section-header__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if show_view_all -%}
        <a class="link-arrow" href="{{ featured.url }}">
          {%- if section.settings.view_all_label != blank -%}
            {{ section.settings.view_all_label }}
          {%- else -%}
            {{ 'general.view_all' | t }}
          {%- endif -%}
          {% render 'icon', icon: 'arrow-right', size: 16 %}
        </a>
      {%- endif -%}
      {%- if is_slider -%}
        <div class="slider__buttons slider__buttons--desktop">
          <button type="button" class="slider__button" data-slider-prev aria-label="{{ 'accessibility.previous' | t }}">
            {% render 'icon', icon: 'chevron-left', size: 18 %}
          </button>
          <button type="button" class="slider__button" data-slider-next aria-label="{{ 'accessibility.next' | t }}">
            {% render 'icon', icon: 'chevron-right', size: 18 %}
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- if is_slider -%}
      <slider-component{% if section.settings.autoscroll %} data-autoscroll="{{ section.settings.autoscroll_speed }}"{% endif %}>
        <ul class="slider slider--bleed" role="list" style="--slides-mobile: 2; --slides-tablet: 3; --slides-desktop: {{ columns }};">
          {%- if featured != blank and featured.products.size > 0 -%}
            {%- assign shown = 0 -%}
            {%- for product in featured.products -%}
              {%- liquid
                if section.settings.hide_incomplete
                  if product.featured_media == blank or product.available == false
                    continue
                  endif
                endif
                if shown >= limit
                  break
                endif
                assign shown = shown | plus: 1
              -%}
              <li class="slider__slide">
                {% render 'product-card', product: product, sizes: sizes %}
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..limit) -%}
              <li class="slider__slide">
                {% render 'product-card', product: blank %}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
      </slider-component>
    {%- else -%}
      <ul class="grid" role="list" style="--cols-mobile: 2; --cols-tablet: 3; --cols-desktop: {{ columns }};">
        {%- if featured != blank and featured.products.size > 0 -%}
          {%- assign shown = 0 -%}
          {%- for product in featured.products -%}
            {%- liquid
              if section.settings.hide_incomplete
                if product.featured_media == blank or product.available == false
                  continue
                endif
              endif
              if shown >= limit
                break
              endif
              assign shown = shown | plus: 1
            -%}
            <li>
              {% render 'product-card', product: product, sizes: sizes %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            <li>
              {% render 'product-card', product: blank %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Coleção em destaque",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Destaques"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção",
      "info": "Sem coleção selecionada, exibe todos os produtos da loja."
    },
    {
      "type": "checkbox",
      "id": "hide_when_empty",
      "label": "Ocultar a seção se a coleção não existir ou estiver vazia",
      "info": "Recomendado para \"Mais vendidos\" e \"Novidades\": evita mostrar a loja inteira sob um título que promete outra coisa. No editor, um aviso indica que a seção está oculta.",
      "default": false
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Quantidade de produtos",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Colunas no desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "slider",
          "label": "Carrossel"
        },
        {
          "value": "grid",
          "label": "Grade"
        }
      ],
      "default": "slider"
    },
    {
      "type": "checkbox",
      "id": "autoscroll",
      "label": "Carrossel que se move sozinho",
      "info": "Só no layout Carrossel. Pausa ao passar o mouse, tocar ou focar, e não anima para quem usa \"reduzir movimento\".",
      "default": false
    },
    {
      "type": "range",
      "id": "autoscroll_speed",
      "label": "Velocidade do movimento (px por segundo)",
      "min": 10,
      "max": 120,
      "step": 5,
      "info": "Quanto maior, mais rápido. Use velocidades diferentes por seção: as mais importantes, como Mais vendidos, ficam mais rápidas.",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar link \"ver tudo\"",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto do link \"ver tudo\"",
      "default": "Ver tudo"
    },
    {
      "type": "checkbox",
      "id": "hide_incomplete",
      "label": "Mostrar só produtos com foto e em estoque",
      "info": "Vitrines da home convertem melhor sem produtos esgotados ou sem imagem.",
      "default": true
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "options": [
        {
          "value": "default",
          "label": "Padrão"
        },
        {
          "value": "alt",
          "label": "Fundo alternativo"
        },
        {
          "value": "inverse",
          "label": "Invertido"
        },
        {
          "value": "accent",
          "label": "Destaque"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaçamento superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaçamento inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Coleção em destaque"
    }
  ]
}
{% endschema %}
