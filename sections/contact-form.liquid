{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign heading = section.settings.heading | default: page.title
  assign label_name = 'templates.contact.form.name' | t
  assign label_phone = 'templates.contact.form.phone' | t
  assign label_order = 'templates.contact.form.order_number' | t
-%}

<div class="section scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container container--medium">
    <div class="section-header">
      <div class="section-header__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h1 class="h1">{{ heading }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="section-header__description">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="contact-form{% if section.blocks.size > 0 %} contact-form--has-aside{% endif %}">
      <div class="contact-form__main">
        {%- if section.settings.show_page_content and page.content != blank -%}
          <div class="rte contact-form__content">{{ page.content }}</div>
        {%- endif -%}

        {%- form 'contact', id: 'ContactForm', class: 'contact-form__form' -%}
          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success" role="status" tabindex="-1" autofocus>
              {% render 'icon', icon: 'check', size: 18 %}
              <span>{{ 'templates.contact.form.success' | t }}</span>
            </div>
          {%- elsif form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
              <div>
                <p>{{ 'templates.contact.form.error_heading' | t }}</p>
                {{ form.errors | default_errors }}
              </div>
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <div class="field">
              <label class="field__label" for="ContactForm-name">{{ label_name }}</label>
              <input
                class="field__input"
                type="text"
                id="ContactForm-name"
                name="contact[{{ label_name | escape }}]"
                value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                autocomplete="name"
                required
              >
            </div>
            <div class="field">
              <label class="field__label" for="ContactForm-email">
                {{ 'templates.contact.form.email' | t }}
              </label>
              <input
                class="field__input"
                type="email"
                inputmode="email"
                id="ContactForm-email"
                name="contact[email]"
                value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                aria-required="true"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
              >
            </div>
          </div>

          <div class="contact-form__row">
            <div class="field">
              <label class="field__label" for="ContactForm-phone">{{ label_phone }}</label>
              <input
                class="field__input"
                type="tel"
                inputmode="tel"
                id="ContactForm-phone"
                name="contact[{{ label_phone | escape }}]"
                value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                autocomplete="tel"
                placeholder="{{ 'templates.contact.form.phone_placeholder' | t }}"
              >
            </div>
            <div class="field">
              <label class="field__label" for="ContactForm-order">
                {{ label_order }}
                <span class="text-muted">({{ 'templates.contact.form.optional' | t }})</span>
              </label>
              <input
                class="field__input"
                type="text"
                id="ContactForm-order"
                name="contact[{{ label_order | escape }}]"
                autocomplete="off"
                placeholder="{{ 'templates.contact.form.order_number_placeholder' | t }}"
              >
            </div>
          </div>

          <div class="field">
            <label class="field__label" for="ContactForm-body">{{ 'templates.contact.form.message' | t }}</label>
            <textarea
              class="field__input"
              id="ContactForm-body"
              name="contact[body]"
              rows="6"
              required
            >
              {{- form.body -}}
            </textarea>
          </div>

          <div class="contact-form__submit">
            <button type="submit" class="button">{{ 'templates.contact.form.submit' | t }}</button>
            {%- if section.settings.response_time != blank -%}
              <p class="text-small text-muted">{{ section.settings.response_time }}</p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <aside class="contact-form__aside" aria-label="{{ 'templates.contact.info_label' | t }}">
          <ul class="contact-form__info" role="list">
            {%- for block in section.blocks -%}
              <li class="contact-form__info-item" {{ block.shopify_attributes }}>
                {%- case block.type -%}
                  {%- when 'whatsapp' -%}
                    {%- liquid
                      assign whatsapp_number = block.settings.number | default: settings.social_whatsapp
                      assign whatsapp_digits = whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
                    -%}
                    <span class="contact-form__info-icon">{% render 'icon', icon: 'whatsapp', size: 22 %}</span>
                    <div>
                      <h2 class="h5">{{ block.settings.title }}</h2>
                      {%- if block.settings.text != blank -%}
                        <p class="text-small text-muted">{{ block.settings.text }}</p>
                      {%- endif -%}
                      {%- if whatsapp_digits != blank -%}
                        <a
                          class="link-arrow contact-form__info-link"
                          href="https://wa.me/{{ whatsapp_digits }}?text={{ settings.whatsapp_message | url_encode }}"
                          target="_blank"
                          rel="noopener"
                        >
                          {{ 'templates.contact.whatsapp_cta' | t }}
                          {% render 'icon', icon: 'arrow-right', size: 16 %}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- when 'email' -%}
                    {%- assign contact_email = block.settings.email | default: shop.email -%}
                    <span class="contact-form__info-icon">{% render 'icon', icon: 'mail', size: 22 %}</span>
                    <div>
                      <h2 class="h5">{{ block.settings.title }}</h2>
                      {%- if block.settings.text != blank -%}
                        <p class="text-small text-muted">{{ block.settings.text }}</p>
                      {%- endif -%}
                      {%- if contact_email != blank -%}
                        <a class="link contact-form__info-link" href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                      {%- endif -%}
                    </div>
                  {%- when 'hours' -%}
                    <span class="contact-form__info-icon">{% render 'icon', icon: 'clock', size: 22 %}</span>
                    <div>
                      <h2 class="h5">{{ block.settings.title }}</h2>
                      {%- if block.settings.text != blank -%}
                        <div class="rte text-small text-muted">{{ block.settings.text }}</div>
                      {%- endif -%}
                    </div>
                {%- endcase -%}
              </li>
            {%- endfor -%}
          </ul>
        </aside>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Formulário de contato",
  "class": "section-contact-form",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Atendimento"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "info": "Deixe em branco para usar o título da página.",
      "default": "Fale com a gente"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Dúvidas sobre produtos, pedidos ou trocas? Nossa equipe está pronta para ajudar."
    },
    {
      "type": "checkbox",
      "id": "show_page_content",
      "label": "Mostrar conteúdo da página",
      "default": true
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Texto ao lado do botão",
      "info": "Ex.: prazo médio de resposta.",
      "default": "Respondemos o mais rápido possível, em horário comercial."
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "whatsapp",
      "name": "WhatsApp",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "WhatsApp"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "O jeito mais rápido de falar com a gente."
        },
        {
          "type": "text",
          "id": "number",
          "label": "Número",
          "info": "Com DDI e DDD, apenas dígitos. Ex.: 5511999999999. Em branco, usa o número das configurações do tema (Redes sociais)."
        }
      ]
    },
    {
      "type": "email",
      "name": "E-mail",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "E-mail"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Para assuntos que precisam de mais detalhes."
        },
        {
          "type": "text",
          "id": "email",
          "label": "Endereço de e-mail",
          "info": "Em branco, usa o e-mail de contato da loja."
        }
      ]
    },
    {
      "type": "hours",
      "name": "Horário de atendimento",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Horário de atendimento"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Horários",
          "default": "<p>Informe aqui os dias e horários de atendimento.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Formulário de contato",
      "blocks": [
        { "type": "whatsapp" },
        { "type": "email" },
        { "type": "hours" }
      ]
    }
  ]
}
{% endschema %}
