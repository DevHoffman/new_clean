{{ 'section-newsletter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'Newsletter-' | append: section.id
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

<div
  class="section scheme-{{ section.settings.color_scheme }} newsletter{% if has_image %} newsletter--has-image{% endif %}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="newsletter__grid">
      {%- if has_image -%}
        <div class="media newsletter__media">
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400, 600, 800, 1000, 1400',
              sizes: '(min-width: 1200px) 600px, (min-width: 750px) 50vw, 100vw',
              loading: 'lazy',
              alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}

      <div class="newsletter__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte newsletter__text">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div class="form-message form-message--success" role="status" tabindex="-1" autofocus>
              {% render 'icon', icon: 'check', size: 18 %}
              <span>
                {%- if section.settings.success_text != blank -%}
                  {{ section.settings.success_text }}
                {%- else -%}
                  {{ 'newsletter.success' | t }}
                {%- endif -%}
              </span>
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="form-message form-message--error" role="alert" id="{{ form_id }}-error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="newsletter__fields">
              <div class="field newsletter__field">
                <label class="field__label visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.label' | t }}</label>
                <input
                  class="field__input"
                  type="email"
                  id="{{ form_id }}-email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  placeholder="{{ 'newsletter.placeholder' | t }}"
                  autocomplete="email"
                  autocapitalize="off"
                  autocorrect="off"
                  spellcheck="false"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                    aria-describedby="{{ form_id }}-error"
                  {% endif %}
                >
              </div>
              <button type="submit" class="button newsletter__button">
                {%- if section.settings.button_label != blank -%}
                  {{ section.settings.button_label }}
                {%- else -%}
                  {{ 'newsletter.button' | t }}
                {%- endif -%}
              </button>
            </div>

            {%- if section.settings.consent != blank -%}
              <div class="rte text-xs newsletter__consent">{{ section.settings.consent }}</div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio",
      "default": "Novidades e ofertas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Receba ofertas em primeira mão"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Cadastre seu e-mail e fique por dentro das novidades e promoções da loja.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão",
      "default": "Quero receber"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Mensagem de sucesso",
      "info": "Opcional. Ex.: peça para conferir o e-mail. Vazio, usa a mensagem padrão do tema."
    },
    {
      "type": "richtext",
      "id": "consent",
      "label": "Texto de consentimento (LGPD)",
      "default": "<p>Ao se cadastrar, você concorda em receber nossas comunicações por e-mail e com a nossa <a href=\"/policies/privacy-policy\">Política de Privacidade</a>. Você pode cancelar a inscrição quando quiser.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem lateral",
      "info": "Opcional."
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "color_scheme": "alt"
      }
    }
  ]
}
{% endschema %}
