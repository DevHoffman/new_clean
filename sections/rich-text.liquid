{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

<div
  class="section scheme-{{ section.settings.color_scheme }} rich-text rich-text--{{ section.settings.alignment }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container container--narrow">
    <div class="rich-text__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte rich-text__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank or section.settings.button_secondary_label != blank -%}
        <div class="rich-text__buttons">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label -}}
            </a>
          {%- endif -%}
          {%- if section.settings.button_secondary_label != blank -%}
            <a class="button button--secondary" href="{{ section.settings.button_secondary_link | default: routes.collections_url }}">
              {{- section.settings.button_secondary_label -}}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Texto",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Limpeza profissional para o dia a dia"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Tamanho do título",
      "options": [
        { "value": "h1", "label": "Grande" },
        { "value": "h2", "label": "Médio" },
        { "value": "h3", "label": "Pequeno" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Use este espaço para contar a história da loja, apresentar uma linha de produtos ou destacar uma mensagem importante para os seus clientes.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto do botão principal",
      "default": "Conhecer a loja"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link do botão principal"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Texto do botão secundário"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Link do botão secundário"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "presets": [
    {
      "name": "Texto"
    }
  ]
}
{% endschema %}
