{{ 'section-brand-list.css' | asset_url | stylesheet_tag }}

<div class="section scheme-{{ section.settings.color_scheme }} brand-list" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- if section.settings.description != blank -%}
            <p class="section-header__description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- liquid
      assign copies = 2
      if section.blocks.size < 8
        assign copies = 4
      endif
    -%}
    <div class="brand-list__marquee" style="--marquee-duration: {{ section.settings.speed }}s;">
      <div class="brand-list__track">
        {%- for copy in (1..copies) -%}
          <ul class="brand-list__items" role="list" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
            {%- for block in section.blocks -%}
              {%- liquid
                assign brand_link = block.settings.link
                if brand_link == blank and block.settings.name != blank
                  assign brand_query = block.settings.name | url_encode
                  if section.settings.link_mode == 'vendor'
                    assign brand_link = routes.collections_url | append: '/vendors?q=' | append: brand_query
                  else
                    assign brand_link = routes.search_url | append: '?type=product&q=' | append: brand_query
                  endif
                endif
              -%}
              <li {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
                <a class="brand-list__item" href="{{ brand_link }}" {% unless forloop.parentloop.first %}tabindex="-1"{% endunless %}>
                  {%- if block.settings.logo != blank -%}
                    {{
                      block.settings.logo
                      | image_url: width: 320
                      | image_tag: widths: '160, 240, 320', sizes: '160px', loading: 'lazy', alt: block.settings.name, class: 'brand-list__logo'
                    }}
                  {%- else -%}
                    <span class="brand-list__name">{{ block.settings.name }}</span>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Marcas",
  "tag": "section",
  "max_blocks": 24,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Marcas"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Marcas que você encontra aqui"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Descrição",
      "default": "Trabalhamos com fabricantes reconhecidos em limpeza profissional e doméstica."
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Duração de uma volta completa",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "s",
      "info": "Quanto maior, mais lento. A rolagem pausa ao passar o mouse e não anima para quem usa \"reduzir movimento\".",
      "default": 40
    },
    {
      "type": "select",
      "id": "link_mode",
      "label": "Como o clique na marca filtra os produtos",
      "options": [
        {
          "value": "search",
          "label": "Busca pelo nome no título (funciona hoje)"
        },
        {
          "value": "vendor",
          "label": "Pelo campo Fornecedor do produto"
        }
      ],
      "info": "Hoje todos os produtos da loja usam o mesmo fornecedor; enquanto o campo não for preenchido por marca, mantenha a busca.",
      "default": "search"
    },
    {
      "type": "header",
      "content": "Aparência"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "options": [
        {
          "value": "default",
          "label": "Padrão"
        },
        {
          "value": "alt",
          "label": "Fundo alternativo"
        },
        {
          "value": "inverse",
          "label": "Invertido"
        },
        {
          "value": "accent",
          "label": "Destaque"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espaçamento superior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espaçamento inferior",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marca",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Nome",
          "default": "Marca"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Sem logo, o nome aparece em texto. Use logos apenas com autorização do fabricante."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Em branco, abre a busca pelo nome da marca."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marcas",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "name": "Azulim"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Start"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Tuff"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Nobre"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Mili"
          }
        },
        {
          "type": "brand",
          "settings": {
            "name": "Veja"
          }
        }
      ]
    }
  ]
}
{% endschema %}
