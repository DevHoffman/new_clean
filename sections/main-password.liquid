{{ 'section-main-password.css' | asset_url | stylesheet_tag }}

<div class="section main-password scheme-{{ section.settings.color_scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.image != blank -%}
    <div class="main-password__media media">
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '400, 600, 800, 1200, 1600',
          sizes: '(min-width: 1000px) 50vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <div class="main-password__content">
    <div class="main-password__inner">
      <div class="main-password__logo">
        {%- if settings.logo != blank -%}
          {{
            settings.logo
            | image_url: width: 400
            | image_tag: widths: '200, 400', sizes: '160px', loading: 'eager', alt: shop.name
          }}
        {%- else -%}
          <span class="h3">{{ shop.name }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h1 class="h1">
        {%- if section.settings.heading != blank -%}
          {{ section.settings.heading }}
        {%- else -%}
          {{ 'templates.password.title' | t }}
        {%- endif -%}
      </h1>

      {%- if shop.password_message != blank -%}
        <div class="rte main-password__text">{{ shop.password_message }}</div>
      {%- elsif section.settings.text != blank -%}
        <div class="rte main-password__text">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="main-password__newsletter">
          {%- form 'customer', id: 'PasswordNewsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,prospect,password page">

            {%- if form.posted_successfully? -%}
              <div class="form-message form-message--success" role="status" tabindex="-1" autofocus>
                {% render 'icon', icon: 'check', size: 18 %}
                <span>{{ 'newsletter.success' | t }}</span>
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="form-message form-message--error" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              {%- if section.settings.newsletter_heading != blank -%}
                <h2 class="h5 main-password__newsletter-title">{{ section.settings.newsletter_heading }}</h2>
              {%- endif -%}

              <div class="main-password__newsletter-row">
                <div class="field">
                  <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
                  <input
                    class="field__input"
                    type="email"
                    inputmode="email"
                    name="contact[email]"
                    id="PasswordNewsletter-email"
                    value="{{ form.email }}"
                    placeholder="{{ 'newsletter.placeholder' | t }}"
                    autocomplete="email"
                    autocorrect="off"
                    autocapitalize="off"
                    required
                    aria-required="true"
                    {% if form.errors %}
                      aria-invalid="true"
                    {% endif %}
                  >
                </div>
                <button type="submit" class="button">{{ 'newsletter.button' | t }}</button>
              </div>
              <p class="text-xs text-muted main-password__consent">{{ 'newsletter.consent' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        {% render 'social-icons', class: 'main-password__social' %}
      {%- endif -%}

      {%- form 'storefront_password', class: 'main-password__login' -%}
        <details class="main-password__details" {% if form.errors %}open{% endif %}>
          <summary class="main-password__summary">
            {% render 'icon', icon: 'lock', size: 16 %}
            <span class="link">{{ 'templates.password.login_toggle' | t }}</span>
          </summary>

          <div class="main-password__login-body">
            {%- if form.errors -%}
              <div class="form-message form-message--error" role="alert">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}

            <div class="main-password__newsletter-row">
              <div class="field">
                <label class="field__label" for="StorefrontPassword">{{ 'templates.password.password_label' | t }}</label>
                <input
                  class="field__input"
                  type="password"
                  name="password"
                  id="StorefrontPassword"
                  autocomplete="current-password"
                  required
                  {% if form.errors %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>
              <button type="submit" class="button button--secondary">{{ 'templates.password.submit' | t }}</button>
            </div>

            <p class="text-xs text-muted">
              {{ 'templates.password.admin_link_html' | t: url: '/admin' }}
            </p>
          </div>
        </details>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Página de senha",
  "class": "section-main-password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem",
      "info": "Opcional. Exibida ao lado do conteúdo no desktop e no topo no celular."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sobretítulo",
      "default": "Em breve"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Estamos preparando algo especial"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "info": "A mensagem definida em Loja virtual > Preferências tem prioridade quando preenchida.",
      "default": "<p>Nossa loja abre em breve. Cadastre seu e-mail para saber em primeira mão e receber as novidades do lançamento.</p>"
    },
    { "type": "header", "content": "Newsletter" },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Mostrar cadastro de e-mail",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Título do cadastro",
      "default": "Avise-me quando abrir"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Mostrar redes sociais",
      "default": true
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "alt" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ]
}
{% endschema %}
