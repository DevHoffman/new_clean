{{ 'section-brand-values.css' | asset_url | stylesheet_tag }}

<div
  class="section scheme-{{ section.settings.color_scheme }} brand-values brand-values--{{ section.settings.alignment }}"
  style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="section-header section-header--center">
        <div class="section-header__text">
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="h2">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <p class="section-header__description">{{ section.settings.description }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <ul
      class="grid brand-values__grid"
      role="list"
      style="--cols-mobile: {{ section.settings.columns_mobile }}; --cols-tablet: 2; --cols-desktop: {{ section.blocks.size | at_least: 1 | at_most: 4 }};"
    >
      {%- for block in section.blocks -%}
        <li class="brand-values__item" {{ block.shopify_attributes }}>
          <span class="brand-values__icon">
            {% render 'icon', icon: block.settings.icon, size: 28 %}
          </span>
          {%- if block.settings.title != blank -%}
            <h3 class="h4 brand-values__title">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="brand-values__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Valores da marca",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto de apoio",
      "default": "Nosso compromisso"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Por que comprar com a gente"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descrição"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alinhamento",
      "options": [
        { "value": "left", "label": "Esquerda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colunas no celular",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "header", "content": "Aparência" },
    { "type": "select", "id": "color_scheme", "label": "Esquema de cores", "options": [
      { "value": "default", "label": "Padrão" },
      { "value": "alt", "label": "Fundo alternativo" },
      { "value": "inverse", "label": "Invertido" },
      { "value": "accent", "label": "Destaque" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Espaçamento superior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Espaçamento inferior", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Valor",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "truck", "label": "Caminhão (frete)" },
            { "value": "box", "label": "Caixa (entrega)" },
            { "value": "credit-card", "label": "Cartão de crédito" },
            { "value": "pix", "label": "Pix" },
            { "value": "refresh", "label": "Setas (troca)" },
            { "value": "shield", "label": "Escudo (segurança)" },
            { "value": "lock", "label": "Cadeado" },
            { "value": "check", "label": "Check" },
            { "value": "leaf", "label": "Folha" },
            { "value": "heart", "label": "Coração" },
            { "value": "sparkle", "label": "Brilho" },
            { "value": "droplet", "label": "Gota" },
            { "value": "flask", "label": "Frasco de laboratório" },
            { "value": "sun", "label": "Sol" },
            { "value": "award", "label": "Medalha" },
            { "value": "star", "label": "Estrela" },
            { "value": "gift", "label": "Presente" },
            { "value": "clock", "label": "Relógio" },
            { "value": "chat", "label": "Balão de conversa" },
            { "value": "mail", "label": "E-mail" },
            { "value": "eye", "label": "Olho" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Diferencial da loja"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Texto",
          "default": "Descreva este diferencial em uma frase."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Valores da marca",
      "blocks": [
        {
          "type": "value",
          "settings": { "icon": "box", "title": "Variedade completa", "text": "Descreva aqui as linhas de produtos que a loja oferece." }
        },
        {
          "type": "value",
          "settings": { "icon": "chat", "title": "Atendimento próximo", "text": "Explique como a sua equipe atende empresas e residências." }
        },
        {
          "type": "value",
          "settings": { "icon": "truck", "title": "Entrega", "text": "Informe as regiões atendidas e como funciona a entrega." }
        },
        {
          "type": "value",
          "settings": { "icon": "shield", "title": "Compra segura", "text": "Conte quais são as formas de pagamento e as garantias da compra." }
        }
      ]
    }
  ]
}
{% endschema %}
