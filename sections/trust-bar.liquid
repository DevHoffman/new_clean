{{ 'section-trust-bar.css' | asset_url | stylesheet_tag }}

{%- if section.blocks.size > 0 -%}
  <div
    class="section scheme-{{ section.settings.color_scheme }} trust-bar trust-bar--{{ section.settings.mobile_layout }}"
    style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="container">
      {%- liquid
        assign visible_items = 0
        for block in section.blocks
          assign vt = block.settings.title
          assign vx = block.settings.text
          if vt contains '[pix]' or vx contains '[pix]'
            unless settings.pix_enabled and settings.pix_confirmed and settings.pix_discount > 0
              continue
            endunless
          endif
          assign visible_items = visible_items | plus: 1
        endfor
      -%}
      <ul class="trust-bar__list" role="list" style="--trust-items: {{ visible_items | at_least: 1 }};">
        {%- for block in section.blocks -%}
          {%- capture trust_title -%}{% render 'claims', text: block.settings.title %}{%- endcapture -%}
          {%- capture trust_text -%}{% render 'claims', text: block.settings.text %}{%- endcapture -%}
          {%- if block.settings.title != blank and trust_title == blank -%}
            {%- continue -%}
          {%- endif -%}
          {%- if trust_title == blank and trust_text == blank -%}
            {%- continue -%}
          {%- endif -%}
          <li class="trust-bar__item" {{ block.shopify_attributes }}>
            <span class="trust-bar__icon">
              {% render 'icon', icon: block.settings.icon, size: 24 %}
            </span>
            <div class="trust-bar__text">
              {%- if trust_title != blank -%}
                <p class="trust-bar__title">{{ trust_title }}</p>
              {%- endif -%}
              {%- if trust_text != blank -%}
                <p class="trust-bar__description">{{ trust_text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

