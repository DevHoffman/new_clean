{%- comment -%}
  Renders an inline SVG icon.

  Accepts:
  - icon: {String} icon name
  - class: {String} extra classes (optional)
  - size: {Number} rendered size in px (optional, default 20)

  Usage:
  {% render 'icon', icon: 'cart' %}
{%- endcomment -%}

{%- liquid
  assign size = size | default: 20
  assign brand_icons = 'whatsapp,instagram,facebook,tiktok,youtube,pinterest,star,star-half,pix' | split: ','
-%}

{%- if brand_icons contains icon -%}
  <svg class="icon icon--{{ icon }}{% if class %} {{ class }}{% endif %}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'star' -%}
        <path d="M12 2.5l2.9 6.2 6.6.8-4.9 4.6 1.3 6.6L12 17.4l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8L12 2.5z"/>
      {%- when 'star-half' -%}
        <path d="M12 2.5v14.9l-5.9 3.3 1.3-6.6L2.5 9.5l6.6-.8L12 2.5z"/>
      {%- when 'whatsapp' -%}
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.200zm4.500-6.100c-.200-.100-1.500-.700-1.700-.800-.200-.100-.400-.100-.600.100-.200.200-.600.800-.800 1-.100.200-.300.200-.500.100a6.700 6.700 0 0 1-3.300-2.900c-.300-.400.300-.400.700-1.300.100-.200 0-.300 0-.500l-.800-1.800c-.200-.500-.400-.400-.600-.400h-.500c-.200 0-.500.100-.700.300-.200.300-.900.900-.900 2.200s1 2.600 1.100 2.700c.100.200 1.900 2.900 4.600 4.100 1.700.700 2.400.800 3.200.700.500-.100 1.500-.600 1.700-1.200.200-.600.200-1.100.200-1.200-.100-.100-.300-.200-.500-.300z"/>
      {%- when 'instagram' -%}
        <path d="M12 7.300A4.700 4.700 0 1 0 12 16.700 4.700 4.700 0 0 0 12 7.300zm0 7.700a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.900a1.100 1.100 0 1 1-2.200 0 1.100 1.100 0 0 1 2.200 0zm3.100 1.100c-.100-1.500-.400-2.800-1.500-3.800-1-1.100-2.300-1.400-3.800-1.500-1.500-.100-6-.100-7.500 0-1.500.100-2.800.400-3.800 1.500-1.100 1-1.400 2.300-1.500 3.800-.100 1.500-.100 6 0 7.500.100 1.500.400 2.800 1.500 3.800 1 1.100 2.300 1.400 3.800 1.500 1.500.100 6 .100 7.500 0 1.500-.100 2.800-.400 3.800-1.500 1.100-1 1.400-2.300 1.500-3.800.100-1.500.100-6 0-7.500zm-2 9.100a3.100 3.100 0 0 1-1.700 1.700c-1.200.500-4 .400-5.400.400s-4.200.100-5.400-.400a3.100 3.100 0 0 1-1.700-1.700c-.500-1.200-.400-4-.400-5.400s-.100-4.200.400-5.400a3.100 3.100 0 0 1 1.700-1.700c1.200-.500 4-.400 5.400-.400s4.200-.100 5.400.400a3.100 3.100 0 0 1 1.700 1.700c.500 1.200.400 4 .400 5.400s.100 4.200-.400 5.400z"/>
      {%- when 'facebook' -%}
        <path d="M14 8.500V6.800c0-.800.200-1.300 1.400-1.300H17V2.600c-.300 0-1.200-.100-2.400-.100-2.400 0-4 1.400-4 4.100v1.900H8v3.200h2.600V21H14v-9.300h2.600l.4-3.200H14z"/>
      {%- when 'tiktok' -%}
        <path d="M19.300 7.200a4.800 4.800 0 0 1-3.800-4.200h-3.200v12.600a2.700 2.700 0 1 1-1.900-2.600V9.700a5.900 5.900 0 1 0 5.100 5.900V9.500a8 8 0 0 0 3.800 1V7.200z"/>
      {%- when 'youtube' -%}
        <path d="M21.600 7.200a2.500 2.500 0 0 0-1.800-1.800C18.200 5 12 5 12 5s-6.200 0-7.800.400A2.500 2.500 0 0 0 2.400 7.200C2 8.800 2 12 2 12s0 3.200.400 4.800a2.500 2.500 0 0 0 1.800 1.800C5.800 19 12 19 12 19s6.200 0 7.800-.400a2.500 2.500 0 0 0 1.800-1.800c.400-1.600.400-4.800.400-4.800s0-3.200-.400-4.800zM10 15V9l5.200 3L10 15z"/>
      {%- when 'pinterest' -%}
        <path d="M12 2a10 10 0 0 0-3.600 19.300c-.100-.800-.200-2 0-2.900l1.200-5s-.300-.600-.300-1.500c0-1.400.800-2.400 1.800-2.400.900 0 1.300.600 1.300 1.400 0 .900-.500 2.100-.800 3.300-.200 1 .500 1.800 1.500 1.800 1.800 0 3.100-1.900 3.100-4.600 0-2.400-1.700-4.100-4.200-4.100a4.300 4.300 0 0 0-4.500 4.300c0 .900.300 1.800.700 2.300.100.100.100.200.100.300l-.300 1.100c0 .200-.100.200-.300.100-1.200-.600-2-2.400-2-3.800 0-3.100 2.300-6 6.500-6 3.400 0 6.100 2.400 6.100 5.700 0 3.400-2.100 6.100-5.100 6.100-1 0-1.900-.500-2.300-1.100l-.600 2.400c-.200.900-.800 1.900-1.200 2.600A10 10 0 1 0 12 2z"/>
      {%- when 'pix' -%}
        <path d="M17.300 17.100a2.700 2.700 0 0 1-1.900-.800l-2.800-2.800a.500.500 0 0 0-.700 0l-2.800 2.800a2.700 2.700 0 0 1-1.900.800h-.500l3.500 3.500a2.800 2.800 0 0 0 4 0l3.500-3.500h-.400zM7.200 6.900c.700 0 1.400.300 1.900.800l2.800 2.800c.200.200.500.200.700 0l2.800-2.800a2.700 2.700 0 0 1 1.900-.800h.400l-3.500-3.500a2.800 2.800 0 0 0-4 0L6.700 6.900h.500zm13.400 3.100l-2.100-2.100h-1.200c-.500 0-1 .200-1.300.500l-2.800 2.800a1.500 1.500 0 0 1-2.200 0L8.200 8.400c-.300-.300-.800-.500-1.300-.500H5.500l-2.100 2.100a2.800 2.800 0 0 0 0 4l2.100 2.100h1.400c.500 0 1-.200 1.300-.500l2.800-2.800a1.600 1.600 0 0 1 2.200 0l2.800 2.800c.300.300.800.500 1.300.500h1.200l2.100-2.100a2.800 2.800 0 0 0 0-4z"/>
    {%- endcase -%}
  </svg>
{%- else -%}
  <svg class="icon icon--{{ icon }}{% if class %} {{ class }}{% endif %}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- case icon -%}
      {%- when 'close' -%}
        <path d="M5 5l14 14M19 5L5 19"/>
      {%- when 'menu' -%}
        <path d="M3 6h18M3 12h18M3 18h18"/>
      {%- when 'search' -%}
        <circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/>
      {%- when 'account' -%}
        <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.400 3.600-7 8-7s8 2.600 8 7"/>
      {%- when 'cart' -%}
        <path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V7a3 3 0 0 1 6 0v1"/>
      {%- when 'chevron-down' -%}
        <path d="M5 9l7 7 7-7"/>
      {%- when 'chevron-left' -%}
        <path d="M15 5l-7 7 7 7"/>
      {%- when 'chevron-right' -%}
        <path d="M9 5l7 7-7 7"/>
      {%- when 'arrow-right' -%}
        <path d="M4 12h16M14 6l6 6-6 6"/>
      {%- when 'plus' -%}
        <path d="M12 5v14M5 12h14"/>
      {%- when 'minus' -%}
        <path d="M5 12h14"/>
      {%- when 'check' -%}
        <path d="M4 12.500l5 5L20 6.500"/>
      {%- when 'truck' -%}
        <path d="M2 6h12v10H2zM14 9h4l4 4v3h-8z"/><circle cx="6.500" cy="18" r="2"/><circle cx="17.500" cy="18" r="2"/>
      {%- when 'shield' -%}
        <path d="M12 3l8 3v6c0 4.500-3.200 8-8 9-4.800-1-8-4.500-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>
      {%- when 'lock' -%}
        <rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>
      {%- when 'leaf' -%}
        <path d="M20 4C10 4 5 9 5 15c0 1.500.400 2.800 1 4 6 0 14-3 14-15z"/><path d="M4 21c2-5 6-9 11-12"/>
      {%- when 'heart' -%}
        <path d="M12 20s-8-4.900-8-10.500A4.500 4.500 0 0 1 12 7a4.500 4.500 0 0 1 8 2.500C20 15.100 12 20 12 20z"/>
      {%- when 'refresh' -%}
        <path d="M4 12a8 8 0 0 1 14-5.300L20 9M20 4v5h-5M20 12a8 8 0 0 1-14 5.300L4 15M4 20v-5h5"/>
      {%- when 'credit-card' -%}
        <rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20M6 15h4"/>
      {%- when 'tag' -%}
        <path d="M20.590 13.410l-7.170 7.170a2 2 0 0 1-2.830 0L2 12V2h10l8.590 8.590a2 2 0 0 1 0 2.820z"/><path d="M7 7h.010"/>
      {%- when 'gift' -%}
        <path d="M3 9h18v4H3zM5 13h14v8H5zM12 9v12"/><path d="M12 9S10.500 4 8 4a2.500 2.500 0 0 0 0 5h4zm0 0s1.500-5 4-5a2.500 2.500 0 0 1 0 5h-4z"/>
      {%- when 'play' -%}
        <path d="M7 4.500v15l12-7.500-12-7.500z" fill="currentColor"/>
      {%- when 'filter' -%}
        <path d="M3 6h18M6 12h12M10 18h4"/>
      {%- when 'trash' -%}
        <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v5M14 11v5"/>
      {%- when 'sparkle' -%}
        <path d="M12 3l1.800 5.200L19 10l-5.200 1.800L12 17l-1.800-5.200L5 10l5.200-1.800L12 3zM19 16l.700 2.300L22 19l-2.300.700L19 22l-.700-2.300L16 19l2.300-.700L19 16z"/>
      {%- when 'droplet' -%}
        <path d="M12 3s7 7.200 7 12a7 7 0 0 1-14 0c0-4.800 7-12 7-12z"/>
      {%- when 'clock' -%}
        <circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
      {%- when 'mail' -%}
        <rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>
      {%- when 'box' -%}
        <path d="M3 7.500L12 3l9 4.500v9L12 21l-9-4.500v-9z"/><path d="M3 7.500l9 4.500 9-4.500M12 12v9"/>
      {%- when 'flask' -%}
        <path d="M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.800 3h10.400a2 2 0 0 0 1.800-3l-5-9V3"/><path d="M7.500 15h9"/>
      {%- when 'sun' -%}
        <circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.900 4.900l1.400 1.400M17.700 17.700l1.400 1.400M4.900 19.100l1.400-1.400M17.700 6.300l1.400-1.400"/>
      {%- when 'chat' -%}
        <path d="M4 5h16v11H9l-5 4V5z"/>
      {%- when 'award' -%}
        <circle cx="12" cy="9" r="6"/><path d="M8.500 14l-1.500 7 5-3 5 3-1.500-7"/>
      {%- when 'phone' -%}
        <path d="M5 4h4l2 5-2.500 1.500a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
      {%- when 'arrow-up' -%}
        <path d="M12 20V4M6 10l6-6 6 6"/>
      {%- when 'help' -%}
        <circle cx="12" cy="12" r="9"/><path d="M9.500 9.500a2.500 2.500 0 1 1 3.500 2.300c-.700.400-1 .900-1 1.700M12 17h.010"/>
      {%- when 'file-text' -%}
        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>
      {%- when 'eye' -%}
        <path d="M2 12s3.600-7 10-7 10 7 10 7-3.600 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>
      {%- else -%}
        <circle cx="12" cy="12" r="9"/>
    {%- endcase -%}
  </svg>
{%- endif -%}
