{%- comment -%}
  Progress bar towards the free shipping threshold.

  Usage:
  {% render 'free-shipping-bar' %}
{%- endcomment -%}

{%- if settings.free_shipping_bar and settings.free_shipping_threshold > 0 and cart.requires_shipping -%}
  {%- liquid
    assign threshold = settings.free_shipping_threshold | times: 100
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
    assign remaining_money = remaining | money
  -%}
  <div class="shipping-bar{% if remaining <= 0 %} shipping-bar--reached{% endif %}" style="--progress: {{ progress }}%;">
    <p class="shipping-bar__text">
      {%- if remaining > 0 -%}
        {% render 'icon', icon: 'truck', size: 16 %}
        <span>{{ 'cart.shipping_bar.remaining_html' | t: amount: remaining_money }}</span>
      {%- else -%}
        {% render 'icon', icon: 'check', size: 16 %}
        <span>{{ 'cart.shipping_bar.reached' | t }}</span>
      {%- endif -%}
    </p>
    <div
      class="shipping-bar__track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="{{ progress }}"
      aria-label="{{ 'cart.shipping_bar.label' | t }}"
    >
      <div class="shipping-bar__fill"></div>
    </div>
  </div>
{%- endif -%}
