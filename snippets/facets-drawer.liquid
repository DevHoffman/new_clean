{%- comment -%}
  Filter panel: a drawer on mobile, a sidebar on desktop (styles in
  component-facets.css). Shared by the collection and the search results.

  Accepts:
  - filters: {Array} collection.filters or search.filters (required)
  - clear_url: {String} URL that removes every filter, keeping the sort (required)
  - results_count: {Number} number of results, shown on the apply button (required)

  Usage:
  {% render 'facets-drawer', filters: search.filters, clear_url: clear_url, results_count: search.results_count %}
{%- endcomment -%}

<modal-element class="drawer drawer--left facets-drawer" id="FacetsDrawer" role="dialog" aria-label="{{ 'collections.facets.filter' | t }}" hidden>
  <div class="drawer__overlay" data-modal-close></div>
  <div class="drawer__panel" tabindex="-1">
    <div class="drawer__header">
      <p class="drawer__title h4">{{ 'collections.facets.filter' | t }}</p>
      <button type="button" class="icon-button" data-modal-close aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    <div class="drawer__body" data-region="filters">
      {%- for filter in filters -%}
        {%- liquid
          assign is_open = false
          if forloop.index <= 3 or filter.active_values.size > 0
            assign is_open = true
          endif
        -%}
        <details class="accordion facets__group" id="Facet-{{ filter.param_name | handleize }}" {% if is_open %}open{% endif %}>
          <summary class="accordion__summary">
            <span class="accordion__title">
              {{ filter.label }}
              {%- if filter.active_values.size > 0 -%}
                <span class="facets__group-count">{{ filter.active_values.size }}</span>
              {%- endif -%}
            </span>
            {% render 'icon', icon: 'chevron-down', size: 14 %}
          </summary>

          <div class="accordion__content">
            {%- case filter.type -%}
              {%- when 'boolean' -%}
                <label class="checkbox facets__value">
                  <input
                    type="checkbox"
                    form="FacetsForm"
                    name="{{ filter.param_name }}"
                    value="{{ filter.true_value.value }}"
                    {% if filter.true_value.active %}
                      checked
                    {% endif %}
                    {% if filter.true_value.count == 0 and filter.true_value.active == false %}
                      disabled
                    {% endif %}
                  >
                  <span>{{ filter.label }} <span class="text-muted">({{ filter.true_value.count }})</span></span>
                </label>

              {%- when 'list' -%}
                {%- liquid
                  assign is_swatch_filter = false
                  if filter.presentation == 'swatch'
                    assign is_swatch_filter = true
                  endif
                -%}
                <ul class="facets__list{% if is_swatch_filter %} facets__list--swatches{% endif %}" role="list">
                  {%- for value in filter.values -%}
                    <li>
                      <label class="checkbox facets__value{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                        <input
                          type="checkbox"
                          form="FacetsForm"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}
                            checked
                          {% endif %}
                          {% if value.count == 0 and value.active == false %}
                            disabled
                          {% endif %}
                        >
                        {%- if is_swatch_filter -%}
                          <span class="swatch swatch--small" style="{% render 'swatch', value: value, name: value.label %}"></span>
                        {%- endif -%}
                        <span>{{ value.label }} <span class="text-muted">({{ value.count }})</span></span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>

              {%- when 'price_range' -%}
                {%- liquid
                  assign currency_symbol = cart.currency.symbol
                  assign range_max = filter.range_max | divided_by: 100.0 | ceil
                  assign selected_min = ''
                  assign selected_max = ''
                  if filter.min_value.value
                    assign selected_min = filter.min_value.value | divided_by: 100.0 | round
                  endif
                  if filter.max_value.value
                    assign selected_max = filter.max_value.value | divided_by: 100.0 | round
                  endif
                  assign thumb_min = selected_min | default: 0
                  assign thumb_max = selected_max | default: range_max
                -%}
                <price-range class="price-range" data-max="{{ range_max }}">
                  <div class="price-range__slider">
                    <div class="price-range__track"><span class="price-range__fill" data-fill></span></div>
                    <input type="range" class="price-range__thumb" data-thumb="min" min="0" max="{{ range_max }}" step="1" value="{{ thumb_min }}" aria-label="{{ 'collections.facets.from' | t }} ({{ currency_symbol }})">
                    <input type="range" class="price-range__thumb" data-thumb="max" min="0" max="{{ range_max }}" step="1" value="{{ thumb_max }}" aria-label="{{ 'collections.facets.to' | t }} ({{ currency_symbol }})">
                  </div>
                  <div class="price-range__fields">
                    <label class="price-range__field">
                      <span class="price-range__label">{{ 'collections.facets.from' | t }}</span>
                      <span class="price-range__box">
                        <span aria-hidden="true">{{ currency_symbol }}</span>
                        <input
                          type="number"
                          form="FacetsForm"
                          data-field="min"
                          id="Filter-Price-Min"
                          name="{{ filter.min_value.param_name }}"
                          value="{{ selected_min }}"
                          placeholder="0"
                          min="0"
                          max="{{ range_max }}"
                          inputmode="numeric"
                        >
                      </span>
                    </label>
                    <span class="price-range__dash" aria-hidden="true">–</span>
                    <label class="price-range__field">
                      <span class="price-range__label">{{ 'collections.facets.to' | t }}</span>
                      <span class="price-range__box">
                        <span aria-hidden="true">{{ currency_symbol }}</span>
                        <input
                          type="number"
                          form="FacetsForm"
                          data-field="max"
                          id="Filter-Price-Max"
                          name="{{ filter.max_value.param_name }}"
                          value="{{ selected_max }}"
                          placeholder="{{ range_max }}"
                          min="0"
                          max="{{ range_max }}"
                          inputmode="numeric"
                        >
                      </span>
                    </label>
                  </div>
                </price-range>
            {%- endcase -%}
          </div>
        </details>
      {%- endfor -%}
    </div>

    <div class="drawer__footer facets-drawer__footer">
      <a href="{{ clear_url }}" class="button button--secondary" data-facet-link>
        {{ 'collections.facets.clear_all' | t }}
      </a>
      <button type="button" class="button" data-modal-close>
        <span data-region="apply-label">{{ 'collections.facets.show_results' | t: count: results_count }}</span>
      </button>
    </div>
  </div>
</modal-element>
