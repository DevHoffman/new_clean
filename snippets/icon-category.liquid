{%- comment -%}
  Renders an inline SVG icon for product categories and customer segments.
  Same visual language as snippets/icon.liquid (24x24, 1.5 stroke, round caps).

  Accepts:
  - icon: {String} icon name
  - class: {String} extra classes (optional)
  - size: {Number} rendered size in px (optional, default 24)

  Categories: spray, broom, paper-roll, trash-bag, glove, cup, soap, bucket,
  sponge, dispenser, coffee, box
  Segments: building, utensils, medical, briefcase, school, home

  Usage:
  {% render 'icon-category', icon: 'spray', size: 32 %}
{%- endcomment -%}

{%- assign size = size | default: 24 -%}

<svg class="icon icon--{{ icon }}{% if class %} {{ class }}{% endif %}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'spray' -%}
      <path d="M10 3h5v4h-5z"/><path d="M10 5H7"/><path d="M15 6l2.5 2.5"/><path d="M10 7l-2 5v8a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1v-8l-2-5"/><path d="M4 3v.01M4 5v.01M4 7v.01"/>
    {%- when 'broom' -%}
      <path d="M12 2v9"/><path d="M8.5 11h7l2.5 10H6l2.5-10z"/><path d="M7.7 14.5h8.6"/><path d="M10 17.5V21M14 17.5V21"/>
    {%- when 'paper-roll' -%}
      <circle cx="9" cy="9" r="6"/><circle cx="9" cy="9" r="2"/><path d="M9 3h10a1 1 0 0 1 1 1v16l-2.5-1.5L15 20V9"/>
    {%- when 'trash-bag' -%}
      <path d="M9 3l3 3 3-3"/><path d="M12 6c-4 1-7 5-7 9.5C5 19 7.5 21 12 21s7-2 7-5.5C19 11 16 7 12 6z"/><path d="M9.5 11c1.5 1 3.5 1 5 0"/>
    {%- when 'glove' -%}
      <path d="M8 21v-5l-3-4.5a1.5 1.5 0 0 1 2.5-1.7L9 12V5a1.5 1.5 0 0 1 3 0v-.5a1.5 1.5 0 0 1 3 0V6a1.5 1.5 0 0 1 3 0v8c0 2-1 3-1 5v2H8z"/><path d="M12 5v6M15 6v5"/><path d="M8 18h9"/>
    {%- when 'cup' -%}
      <path d="M6 4l1.5 16a1 1 0 0 0 1 1h7a1 1 0 0 0 1-1L18 4"/><path d="M5 4h14"/><path d="M6.5 9h11"/>
    {%- when 'soap' -%}
      <rect x="3" y="11" width="15" height="9" rx="3"/><path d="M7 15.5h7"/><circle cx="17.5" cy="5.5" r="2.5"/><circle cx="11" cy="6" r="1.5"/>
    {%- when 'bucket' -%}
      <path d="M5 9h14l-1.5 11a1 1 0 0 1-1 1h-9a1 1 0 0 1-1-1L5 9z"/><path d="M5 9a7 7 0 0 1 14 0"/><path d="M5.7 14h12.6"/>
    {%- when 'sponge' -%}
      <rect x="3" y="7" width="18" height="11" rx="3"/><path d="M3 11h18"/><path d="M8 14.5v.01M12 15v.01M16 14.5v.01"/>
    {%- when 'dispenser' -%}
      <rect x="7" y="10" width="10" height="11" rx="2"/><path d="M10 7h4v3h-4z"/><path d="M12 7V3h4.5A1.5 1.5 0 0 1 18 4.5V5"/><path d="M10 15.5h4"/>
    {%- when 'coffee' -%}
      <path d="M4 10h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5v-5z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3v3M12 3v3"/>
    {%- when 'box' -%}
      <path d="M3 7.5L12 3l9 4.5v9L12 21l-9-4.5v-9z"/><path d="M3 7.5l9 4.5 9-4.5M12 12v9"/>
    {%- when 'building' -%}
      <path d="M5 21V4a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v17"/><path d="M16 9h2a1 1 0 0 1 1 1v11"/><path d="M3 21h18"/><path d="M9 7h3M9 11h3M9 15h3"/>
    {%- when 'utensils' -%}
      <path d="M7 3v18"/><path d="M4 3v5a3 3 0 0 0 6 0V3"/><path d="M17 21V3c-2 1-3 3.5-3 7v3h3"/>
    {%- when 'medical' -%}
      <rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 8v8M8 12h8"/>
    {%- when 'briefcase' -%}
      <rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M3 13h18"/>
    {%- when 'school' -%}
      <path d="M2 9l10-5 10 5-10 5L2 9z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/><path d="M22 9v6"/>
    {%- when 'home' -%}
      <path d="M3 11l9-8 9 8"/><path d="M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5"/><path d="M10 21v-6h4v6"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
