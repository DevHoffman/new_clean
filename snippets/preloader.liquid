{%- comment -%}
  Loading screen with the logo. Shown for at least 2 seconds once per visit (or on
  every Home load, see the setting) and skipped on the other pages, so it never
  slows down navigation. ?nc_preloader=1 forces it for testing. A CSS failsafe hides it even if JavaScript fails.

  Usage:
  {% render 'preloader' %}
{%- endcomment -%}

<div class="preloader" id="Preloader" aria-hidden="true">
  <div class="preloader__inner">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 360 | image_tag: class: 'preloader__logo', loading: 'eager', alt: '', sizes: '180px', widths: '180, 360' }}
    {%- else -%}
      <img
        class="preloader__logo preloader__logo--fallback"
        src="{{ 'logo-new-clean.png' | asset_img_url: '360x' }}"
        alt=""
        width="500"
        height="350"
        loading="eager"
      >
    {%- endif -%}
    <span class="preloader__bar"><span></span></span>
  </div>
</div>
<script>
  (function () {
    var preloader = document.getElementById('Preloader');
    var frequency = {{ settings.preloader_frequency | default: 'session' | json }};
    var isHome = {{ template.name | json }} === 'index';
    var forced = /[?&]nc_preloader=1/.test(window.location.search);
    var skip = document.documentElement.getAttribute('data-fx') === 'lite';
    if (!forced) {
      try {
        if (frequency === 'home') {
          skip = skip || !isHome;
        } else {
          skip = skip || window.sessionStorage.getItem('newclean:loaded') === '1';
          window.sessionStorage.setItem('newclean:loaded', '1');
        }
      } catch (error) {
        // Storage unavailable: show the preloader
      }
    } else {
      skip = false;
    }
    if (skip) {
      preloader.parentNode.removeChild(preloader);
      return;
    }
    var started = Date.now();
    function hide() {
      // Minimum display time: 2 seconds (the CSS failsafe only kicks in at 4 s)
      var wait = Math.max(0, 2000 - (Date.now() - started));
      window.setTimeout(function () {
        preloader.classList.add('is-hidden');
        window.setTimeout(function () {
          if (preloader.parentNode) preloader.parentNode.removeChild(preloader);
        }, 450);
      }, wait);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hide);
    else hide();
  })();
</script>
