{%- comment -%}
  Payment method icons: the ones enabled by the gateways in Shopify plus,
  optionally, Pix and boleto badges when the gateway does not expose them.

  Accepts:
  - class: {String} extra classes for the list (optional)

  Usage:
  {% render 'payment-icons' %}
{%- endcomment -%}

{%- liquid
  assign types = shop.enabled_payment_types
  assign show_pix = false
  assign show_boleto = false
  if settings.payment_icon_pix
    unless types contains 'pix'
      assign show_pix = true
    endunless
  endif
  if settings.payment_icon_boleto
    unless types contains 'boleto'
      assign show_boleto = true
    endunless
  endif
-%}

{%- if types.size > 0 or show_pix or show_boleto -%}
  <ul class="payment-icons{% if class %} {{ class }}{% endif %}" role="list" aria-label="{{ 'sections.footer.payment_methods' | t }}">
    {%- for type in types -%}
      <li>{{ type | payment_type_svg_tag }}</li>
    {%- endfor -%}
    {%- if show_pix -%}
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Pix">
          <rect x=".5" y=".5" width="37" height="23" rx="3" fill="#fff" stroke="#d0dcee"/>
          <g transform="translate(6 3) scale(0.75)" fill="#32BCAD">
            <path d="M17.3 17.1a2.7 2.7 0 0 1-1.9-.8l-2.8-2.8a.5.5 0 0 0-.7 0l-2.8 2.8a2.7 2.7 0 0 1-1.9.8h-.5l3.5 3.5a2.8 2.8 0 0 0 4 0l3.5-3.5h-.4zM7.2 6.9c.7 0 1.4.3 1.9.8l2.8 2.8c.2.2.5.2.7 0l2.8-2.8a2.7 2.7 0 0 1 1.9-.8h.4l-3.5-3.5a2.8 2.8 0 0 0-4 0L6.7 6.9h.5zm13.4 3.1l-2.1-2.1h-1.2c-.5 0-1 .2-1.3.5l-2.8 2.8a1.5 1.5 0 0 1-2.2 0L8.2 8.4c-.3-.3-.8-.5-1.3-.5H5.5l-2.1 2.1a2.8 2.8 0 0 0 0 4l2.1 2.1h1.4c.5 0 1-.2 1.3-.5l2.8-2.8a1.6 1.6 0 0 1 2.2 0l2.8 2.8c.3.3.8.5 1.3.5h1.2l2.1-2.1a2.8 2.8 0 0 0 0-4z"/>
          </g>
          <text x="30" y="15.5" text-anchor="middle" font-family="Arial, sans-serif" font-size="7" font-weight="700" fill="#0d1f3c">Pix</text>
        </svg>
      </li>
    {%- endif -%}
    {%- if show_boleto -%}
      <li>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 38 24" width="38" height="24" role="img" aria-label="Boleto">
          <rect x=".5" y=".5" width="37" height="23" rx="3" fill="#fff" stroke="#d0dcee"/>
          <g fill="#0d1f3c">
            <rect x="6" y="6" width="1.5" height="12"/><rect x="9" y="6" width="1" height="12"/><rect x="11.5" y="6" width="2" height="12"/><rect x="15" y="6" width="1" height="12"/><rect x="17.5" y="6" width="1.5" height="12"/><rect x="20.5" y="6" width="1" height="12"/><rect x="23" y="6" width="2" height="12"/><rect x="26.5" y="6" width="1" height="12"/><rect x="29" y="6" width="1.5" height="12"/><rect x="32" y="6" width="1" height="12"/>
          </g>
        </svg>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
