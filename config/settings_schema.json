[
  {
    "name": "theme_info",
    "theme_name": "New Clean",
    "theme_version": "2.0.0",
    "theme_author": "Automatiza",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://help.shopify.com/manual/online-store/themes"
  },
  {
    "name": "Logo e favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Se nenhum logo for enviado, o tema usa o logo New Clean incluído nos arquivos do tema."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 260,
        "step": 10,
        "unit": "px",
        "label": "Largura do logo (desktop)",
        "default": 130
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "min": 60,
        "max": 200,
        "step": 10,
        "unit": "px",
        "label": "Largura do logo (mobile)",
        "default": 100
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Recomendado: 96 x 96 px"
      }
    ]
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "header",
        "content": "Base"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fundo",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Fundo alternativo",
        "info": "Usado em seções de destaque, cartões e rodapé.",
        "default": "#F4F6FA"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Texto",
        "default": "#0D1F3C"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Texto secundário",
        "default": "#5B6F8E"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Bordas",
        "default": "#D0DCEE"
      },
      {
        "type": "header",
        "content": "Marca e botões"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Cor de destaque",
        "info": "Links, selos e detalhes da marca.",
