      },
      {
        "type": "header",
        "content": "Sinalização"
      },
      {
        "type": "color",
        "id": "color_sale",
        "label": "Promoção",
        "default": "#C62828"
      },
      {
        "type": "color",
        "id": "color_success",
        "label": "Sucesso",
        "default": "#1E7A55"
      },
      {
        "type": "color",
        "id": "color_rating",
        "label": "Estrelas de avaliação",
        "default": "#F5A623"
      },
      {
        "type": "header",
        "content": "Seções invertidas"
      },
      {
        "type": "color",
        "id": "color_inverse_background",
